# 报价系统部署 — tong 用户免密码执行
# 放到 /etc/sudoers.d/quote-system 后执行 chmod 0440 /etc/sudoers.d/quote-system

Defaults:tong !use_pty
tong ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart quote-system
tong ALL=(ALL) NOPASSWD: /usr/bin/systemctl status quote-system
tong ALL=(ALL) NOPASSWD: /bin/rm -rf /opt/quote-system/frontend/dist
